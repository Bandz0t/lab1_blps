<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_YoutubeMonetizationExecutable"
                  targetNamespace="http://example.com/youtube-monetization">

  <bpmn:message id="Message_VideoProcessingCompleted" name="VideoProcessingCompleted"/>
  <bpmn:message id="Message_MonthlyPayoutCompleted" name="MonthlyPayoutCompleted"/>

  <bpmn:process id="youtube_monetization_process" name="YouTube video publication and monetization" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="videoUploadedStart" name="Video uploaded">
      <bpmn:outgoing>Flow_video_start_queue</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="queueVideoProcessingTask" name="Queue Kafka video processing" camunda:delegateExpression="${queueVideoProcessingDelegate}">
      <bpmn:incoming>Flow_video_start_queue</bpmn:incoming>
      <bpmn:outgoing>Flow_video_queue_wait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="waitVideoProcessingCompleted" name="Wait async processing result">
      <bpmn:incoming>Flow_video_queue_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_video_wait_gateway</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VideoProcessingCompleted"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="videoProcessingResultGateway" name="Validation and copyright result">
      <bpmn:incoming>Flow_video_wait_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_video_rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_video_manual_copyright</bpmn:outgoing>
      <bpmn:outgoing>Flow_video_choose_monetization</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="videoRejectedEnd" name="Video rejected">
      <bpmn:incoming>Flow_video_rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="reviewCopyrightTask"
                   name="Review copyright status"
                   camunda:candidateGroups="MODERATOR,ADMIN"
                   camunda:formRef="copyright-review-form"
                   camunda:formRefBinding="latest">
      <bpmn:extensionElements>
        <camunda:taskListener event="complete" delegateExpression="${copyrightDecisionTaskListener}"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_video_manual_copyright</bpmn:incoming>
      <bpmn:outgoing>Flow_video_copyright_gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="copyrightDecisionGateway" name="Copyright cleared?">
      <bpmn:incoming>Flow_video_copyright_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_video_revision_required</bpmn:outgoing>
      <bpmn:outgoing>Flow_video_copyright_to_monetization</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="revisionRequiredEnd" name="Revision required">
      <bpmn:incoming>Flow_video_revision_required</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="chooseMonetizationTask"
                   name="Choose monetization"
                   camunda:candidateGroups="AUTHOR,ADMIN"
                   camunda:formRef="monetization-selection-form"
                   camunda:formRefBinding="latest">
      <bpmn:extensionElements>
        <camunda:taskListener event="complete" delegateExpression="${monetizationTaskListener}"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_video_choose_monetization</bpmn:incoming>
      <bpmn:incoming>Flow_video_copyright_to_monetization</bpmn:incoming>
      <bpmn:outgoing>Flow_video_published</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="videoPublishedEnd" name="Published">
      <bpmn:incoming>Flow_video_published</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_video_start_queue" sourceRef="videoUploadedStart" targetRef="queueVideoProcessingTask"/>
    <bpmn:sequenceFlow id="Flow_video_queue_wait" sourceRef="queueVideoProcessingTask" targetRef="waitVideoProcessingCompleted"/>
    <bpmn:sequenceFlow id="Flow_video_wait_gateway" sourceRef="waitVideoProcessingCompleted" targetRef="videoProcessingResultGateway"/>
    <bpmn:sequenceFlow id="Flow_video_rejected" name="Validation failed" sourceRef="videoProcessingResultGateway" targetRef="videoRejectedEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${validationPassed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_video_manual_copyright" name="Manual copyright review" sourceRef="videoProcessingResultGateway" targetRef="reviewCopyrightTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${validationPassed == true and copyrightCleared == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_video_choose_monetization" name="Copyright cleared" sourceRef="videoProcessingResultGateway" targetRef="chooseMonetizationTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${validationPassed == true and copyrightCleared == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_video_copyright_gateway" sourceRef="reviewCopyrightTask" targetRef="copyrightDecisionGateway"/>
    <bpmn:sequenceFlow id="Flow_video_revision_required" name="Issue found" sourceRef="copyrightDecisionGateway" targetRef="revisionRequiredEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${copyrightCleared == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_video_copyright_to_monetization" name="No issue" sourceRef="copyrightDecisionGateway" targetRef="chooseMonetizationTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${copyrightCleared == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_video_published" sourceRef="chooseMonetizationTask" targetRef="videoPublishedEnd"/>
  </bpmn:process>

  <bpmn:process id="monthly_payout_process" name="Monthly payout orchestration" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="monthlyPayoutStart" name="Monthly payout requested">
      <bpmn:outgoing>Flow_monthly_start_queue</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="queueMonthlyPayoutTask" name="Queue Kafka monthly payout" camunda:delegateExpression="${requestMonthlyPayoutDelegate}">
      <bpmn:incoming>Flow_monthly_start_queue</bpmn:incoming>
      <bpmn:outgoing>Flow_monthly_queue_wait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="waitMonthlyPayoutCompleted" name="Wait monthly payout completion">
      <bpmn:incoming>Flow_monthly_queue_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_monthly_completed</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_MonthlyPayoutCompleted"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="monthlyPayoutCompletedEnd" name="Monthly payout completed">
      <bpmn:incoming>Flow_monthly_completed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_monthly_start_queue" sourceRef="monthlyPayoutStart" targetRef="queueMonthlyPayoutTask"/>
    <bpmn:sequenceFlow id="Flow_monthly_queue_wait" sourceRef="queueMonthlyPayoutTask" targetRef="waitMonthlyPayoutCompleted"/>
    <bpmn:sequenceFlow id="Flow_monthly_completed" sourceRef="waitMonthlyPayoutCompleted" targetRef="monthlyPayoutCompletedEnd"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_YoutubeMonetizationExecutable">
    <bpmndi:BPMNPlane id="Plane_YoutubeMonetizationExecutable" bpmnElement="youtube_monetization_process">
      <bpmndi:BPMNShape id="videoUploadedStart_di" bpmnElement="videoUploadedStart"><dc:Bounds x="160" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="queueVideoProcessingTask_di" bpmnElement="queueVideoProcessingTask"><dc:Bounds x="250" y="98" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="waitVideoProcessingCompleted_di" bpmnElement="waitVideoProcessingCompleted"><dc:Bounds x="450" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="videoProcessingResultGateway_di" bpmnElement="videoProcessingResultGateway" isMarkerVisible="true"><dc:Bounds x="550" y="113" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewCopyrightTask_di" bpmnElement="reviewCopyrightTask"><dc:Bounds x="690" y="210" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="copyrightDecisionGateway_di" bpmnElement="copyrightDecisionGateway" isMarkerVisible="true"><dc:Bounds x="910" y="225" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="chooseMonetizationTask_di" bpmnElement="chooseMonetizationTask"><dc:Bounds x="1060" y="98" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="videoPublishedEnd_di" bpmnElement="videoPublishedEnd"><dc:Bounds x="1280" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="videoRejectedEnd_di" bpmnElement="videoRejectedEnd"><dc:Bounds x="690" y="20" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="revisionRequiredEnd_di" bpmnElement="revisionRequiredEnd"><dc:Bounds x="1060" y="320" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_video_start_queue_di" bpmnElement="Flow_video_start_queue"><di:waypoint x="196" y="138"/><di:waypoint x="250" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_video_queue_wait_di" bpmnElement="Flow_video_queue_wait"><di:waypoint x="390" y="138"/><di:waypoint x="450" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_video_wait_gateway_di" bpmnElement="Flow_video_wait_gateway"><di:waypoint x="486" y="138"/><di:waypoint x="550" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_video_rejected_di" bpmnElement="Flow_video_rejected"><di:waypoint x="575" y="113"/><di:waypoint x="575" y="38"/><di:waypoint x="690" y="38"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_video_manual_copyright_di" bpmnElement="Flow_video_manual_copyright"><di:waypoint x="575" y="163"/><di:waypoint x="575" y="250"/><di:waypoint x="690" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_video_choose_monetization_di" bpmnElement="Flow_video_choose_monetization"><di:waypoint x="600" y="138"/><di:waypoint x="1060" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_video_copyright_gateway_di" bpmnElement="Flow_video_copyright_gateway"><di:waypoint x="840" y="250"/><di:waypoint x="910" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_video_revision_required_di" bpmnElement="Flow_video_revision_required"><di:waypoint x="935" y="275"/><di:waypoint x="935" y="338"/><di:waypoint x="1060" y="338"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_video_copyright_to_monetization_di" bpmnElement="Flow_video_copyright_to_monetization"><di:waypoint x="960" y="250"/><di:waypoint x="1000" y="250"/><di:waypoint x="1000" y="138"/><di:waypoint x="1060" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_video_published_di" bpmnElement="Flow_video_published"><di:waypoint x="1210" y="138"/><di:waypoint x="1280" y="138"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
