    <bpmn:group id="Group_Publication" categoryValueRef="CategoryValue_Publication" />
    <bpmn:group id="Group_Monetization" categoryValueRef="CategoryValue_Monetization" />
    <bpmn:group id="Group_Moderation" categoryValueRef="CategoryValue_Moderation" />
    <bpmn:conversationNode id="Conv_UploadPublication" name="Диалог: загрузка и публикация">
      <bpmn:participantRef>Participant_YouTube</bpmn:participantRef>
    </bpmn:conversationNode>
    <bpmn:conversationNode id="Conv_Comments" name="Диалог: комментарии и модерация">
      <bpmn:participantRef>Participant_YouTube</bpmn:participantRef>
    </bpmn:conversationNode>
    <bpmn:conversationNode id="Conv_AdsRevenue" name="Диалог: рекламная выручка">
      <bpmn:participantRef>Participant_YouTube</bpmn:participantRef>
    </bpmn:conversationNode>
    <bpmn:conversationNode id="Conv_Report" name="Диалог: отчёт и выплата">
      <bpmn:participantRef>Participant_YouTube</bpmn:participantRef>
    </bpmn:conversationNode>
    <bpmn:conversationLink id="ConvLink_1" sourceRef="Conv_UploadPublication" targetRef="Conv_AdsRevenue" name="Публикация → Монетизация" />
