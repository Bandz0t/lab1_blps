  </bpmn:collaboration>
  <bpmn:process id="Process_YouTube" name="Управление видео, монетизация и модерация комментариев на YouTube" isExecutable="true">
    <bpmn:laneSet id="LaneSet_YouTube">
      <bpmn:lane id="Lane_Moderation" name="Модерация комментариев">
        <bpmn:flowNodeRef>SubProcess_CommentModeration</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Monetization" name="Сервис монетизации">
        <bpmn:flowNodeRef>Task_SendPayoutReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRevenueData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestRevenueData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TimerMonthly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AggregateAnalytics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateAuthorRevenue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessPayout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_MonthClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Video" name="Видео-сервис">
        <bpmn:flowNodeRef>Gateway_PublishMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MonetizationAllowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CopyrightIssues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateVideo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DisableMonetization</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnableMonetization</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishVideo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyRestrictions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCopyright</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_VideoUpload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1gza6wh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RevisionRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckMonetizationPolicy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_012otcg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1qhitgb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1h8puw3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0bzdjs7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_NotifyPublished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sendTask id="Task_SendPayoutReport" name="Отправить отчёт и выплату" messageRef="Msg_PayoutReport">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveRevenueData" name="Получить отчёт по рекламе" messageRef="Msg_RevenueResponse">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Task_RequestRevenueData" name="Запросить рекламную выручку" messageRef="Msg_RevenueRequest">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_TimerMonthly" name="Конец расчётного месяца">
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_PublishMerge" name="Параметры готовы">
      <bpmn:incoming>Flow_10_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_10_No</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_MonetizationAllowed" name="Монетизация разрешена?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_CopyrightIssues" name="Есть нарушения?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RequestRevision" name="Запросить исправление видео">
      <bpmn:incoming>Flow_04_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_1nozvzb</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_ValidateVideo" name="Проверка формата и метаданных">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DisableMonetization" name="Опубликовать без монетизации">
      <bpmn:incoming>Flow_09_No</bpmn:incoming>
      <bpmn:outgoing>Flow_10_No</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EnableMonetization" name="Включить монетизацию">
      <bpmn:incoming>Flow_09_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Yes</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PublishVideo" name="Опубликовать видео">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_16n9ssh">
        <bpmn:targetRef>DataStoreReference_0sdrwq5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_AggregateAnalytics" name="Собрать просмотры и CTR">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CalculateAuthorRevenue" name="Рассчитать доход автора">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProcessPayout" name="Подготовить выплату">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApplyRestrictions" name="Применить возрастные ограничения">
      <bpmn:incoming>Flow_04_No</bpmn:incoming>
      <bpmn:outgoing>Flow_06n6ipj</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckCopyright" name="Проверка авторских прав (Content ID)">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="StartEvent_VideoUpload" name="Получено видео и метаданные">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_16wwm7j" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_SendPayoutReport" targetRef="EndEvent_MonthClosed" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ProcessPayout" targetRef="Task_SendPayoutReport" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_RequestRevenueData" targetRef="Task_ReceiveRevenueData" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ReceiveRevenueData" targetRef="Task_CalculateAuthorRevenue" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_AggregateAnalytics" targetRef="Task_RequestRevenueData" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Event_TimerMonthly" targetRef="Task_AggregateAnalytics" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PublishVideo" targetRef="Event_NotifyPublished" />
    <bpmn:sequenceFlow id="Flow_10_No" sourceRef="Task_DisableMonetization" targetRef="Gateway_PublishMerge" />
    <bpmn:sequenceFlow id="Flow_10_Yes" sourceRef="Task_EnableMonetization" targetRef="Gateway_PublishMerge" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_PublishMerge" targetRef="Task_PublishVideo" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_CheckMonetizationPolicy" targetRef="Gateway_MonetizationAllowed" />
    <bpmn:sequenceFlow id="Flow_09_No" name="Нет" sourceRef="Gateway_MonetizationAllowed" targetRef="Task_DisableMonetization">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">monetizationAllowed == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_Yes" name="Да" sourceRef="Gateway_MonetizationAllowed" targetRef="Task_EnableMonetization">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">monetizationAllowed == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CheckCopyright" targetRef="Gateway_CopyrightIssues" />
    <bpmn:sequenceFlow id="Flow_04_Yes" name="Да" sourceRef="Gateway_CopyrightIssues" targetRef="Task_RequestRevision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">copyrightIssue == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04_No" name="Нет" sourceRef="Gateway_CopyrightIssues" targetRef="Task_ApplyRestrictions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">copyrightIssue == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_RequestRevision" targetRef="EndEvent_RevisionRequired" />
    <bpmn:sequenceFlow id="Flow_1nozvzb" sourceRef="Task_RequestRevision" targetRef="Event_1h8puw3" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_VideoUpload" targetRef="Task_ValidateVideo" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ValidateVideo" targetRef="Task_CheckCopyright" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CalculateAuthorRevenue" targetRef="Task_ProcessPayout" />
    <bpmn:dataStoreReference id="DataStoreReference_0sdrwq5" name="видео" />
    <bpmn:boundaryEvent id="Event_1gza6wh" name="Ошибка формата файла" attachedToRef="Task_ValidateVideo">
      <bpmn:outgoing>Flow_1ob0vzu</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_158nqld" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_RevisionRequired" name="Публикация отклонена">
      <bpmn:incoming>Flow_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Task_CheckMonetizationPolicy" name="Проверить правила монетизации">
      <bpmn:incoming>Flow_0zsajtx</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="Event_012otcg" name="Получены авторские настройки">
      <bpmn:outgoing>Flow_0zsajtx</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0dyxgdd" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_06n6ipj" sourceRef="Task_ApplyRestrictions" targetRef="Event_1qhitgb" />
    <bpmn:sequenceFlow id="Flow_0zsajtx" sourceRef="Event_012otcg" targetRef="Task_CheckMonetizationPolicy" />
    <bpmn:intermediateThrowEvent id="Event_1qhitgb" name="Отправить запрос на настойку публикации и рекламы">
      <bpmn:incoming>Flow_06n6ipj</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_017ey9f" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_1ob0vzu" sourceRef="Event_1gza6wh" targetRef="Event_0bzdjs7" />
    <bpmn:endEvent id="Event_1h8puw3" name="Отправка сообщения об исправлениях">
      <bpmn:incoming>Flow_1nozvzb</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_147pirp" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_0bzdjs7" name="Файл не прошел">
      <bpmn:incoming>Flow_1ob0vzu</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1h6qknh" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_NotifyPublished" name="Уведомить автора о публикации">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0u4nmyg" messageRef="Msg_PublishNotice" />
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_CommentModeration" name="Событийный подпроцесс модерации комментариев" triggeredByEvent="true">
      <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_CommentReceived" targetRef="Task_AutoCheckComment" />
      <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_PublishComment" targetRef="EndEvent_CommentPublished" />
      <bpmn:sequenceFlow id="Flow_C7" sourceRef="Task_DeleteComment" targetRef="EndEvent_CommentDeleted" />
      <bpmn:task id="Task_AutoCheckComment" name="Автопроверка комментария">
        <bpmn:incoming>Flow_C1</bpmn:incoming>
        <bpmn:outgoing>Flow_0a9dai8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_PublishComment" name="Опубликовать комментарий">
        <bpmn:incoming>Flow_1eoj330</bpmn:incoming>
        <bpmn:outgoing>Flow_C4</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_0g641py">
          <bpmn:targetRef>DataStoreReference_0jrkkd1</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:task>
      <bpmn:task id="Task_DeleteComment" name="Удалить комментарий">
        <bpmn:incoming>Flow_19b9aqq</bpmn:incoming>
        <bpmn:outgoing>Flow_C7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateThrowEvent id="Event_1fuwcko" name="Направить комментарий модератору">
        <bpmn:incoming>Flow_1p6mc4n</bpmn:incoming>
        <bpmn:messageEventDefinition id="MessageEventDefinition_09wsbx1" />
      </bpmn:intermediateThrowEvent>
      <bpmn:startEvent id="StartEvent_CommentReceived" name="Получен комментарий" isInterrupting="false">
        <bpmn:outgoing>Flow_C1</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_0mqkxis">
          <bpmn:targetRef>DataStoreReference_0jrkkd1</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:messageEventDefinition id="MessageEventDefinition_05sjplh" messageRef="Msg_CommentData" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0a9dai8" sourceRef="Task_AutoCheckComment" targetRef="Gateway_13958lg" />
      <bpmn:intermediateCatchEvent id="Event_02lykcz" name="Одобрен комментарий">
        <bpmn:outgoing>Flow_1n3a7uc</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1hsmc9f" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="Event_1rlbtbc" name="Отклонить комментарий">
        <bpmn:outgoing>Flow_19b9aqq</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0adin4u" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_1n3a7uc" sourceRef="Event_02lykcz" targetRef="Gateway_00oeg3w" />
      <bpmn:sequenceFlow id="Flow_19b9aqq" sourceRef="Event_1rlbtbc" targetRef="Task_DeleteComment" />
      <bpmn:exclusiveGateway id="Gateway_00oeg3w">
        <bpmn:incoming>Flow_1n3a7uc</bpmn:incoming>
        <bpmn:incoming>Flow_1bcbimx</bpmn:incoming>
        <bpmn:outgoing>Flow_1eoj330</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_1eoj330" sourceRef="Gateway_00oeg3w" targetRef="Task_PublishComment" />
      <bpmn:dataStoreReference id="DataStoreReference_0jrkkd1" name="комментарии" />
      <bpmn:exclusiveGateway id="Gateway_13958lg" name="Комментарий прошел проверку?">
        <bpmn:incoming>Flow_0a9dai8</bpmn:incoming>
        <bpmn:outgoing>Flow_1bcbimx</bpmn:outgoing>
        <bpmn:outgoing>Flow_1p6mc4n</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_1bcbimx" name="да" sourceRef="Gateway_13958lg" targetRef="Gateway_00oeg3w" />
      <bpmn:sequenceFlow id="Flow_1p6mc4n" name="нет" sourceRef="Gateway_13958lg" targetRef="Event_1fuwcko" />
      <bpmn:endEvent id="EndEvent_CommentDeleted" name="Комментарий удалён">
        <bpmn:incoming>Flow_C7</bpmn:incoming>
        <bpmn:terminateEventDefinition id="TerminateEventDefinition_1r0e6jh" />
      </bpmn:endEvent>
      <bpmn:endEvent id="EndEvent_CommentPublished" name="Комментарий опубликован">
        <bpmn:incoming>Flow_C4</bpmn:incoming>
        <bpmn:terminateEventDefinition id="TerminateEventDefinition_0uqpmas" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent_MonthClosed" name="Монетизация за период завершена">
